# ======================================================
# SUSpicious Totem - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env no desenvolvimento local
# ======================================================

# Nome do Projeto
PROJECT_NAME="SUSpicious Totem"

# Modo da Impressora: "mock" (imprime no terminal) ou "escpos" (impressora física USB)
PRINTER_MODE=mock

# IDs da Impressora Física USB (Apenas se PRINTER_MODE=escpos)
PRINTER_VENDOR_ID=0x04b8
PRINTER_PRODUCT_ID=0x0202

# URL do Banco de Dados SQLite local
DATABASE_URL=sqlite:///./suspicious_totem.db

# Configurações do e-SUS PEC (Simulação ou Integração Real)
ESUS_API_URL=https://exemplo-esus-ubs.gov.br/api
ESUS_API_TOKEN=token_exemplo_desenvolvimento
